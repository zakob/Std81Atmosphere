#:kivy 2.3.1

<FieldInput@TextInput>:
    background_color: 0.16, 0.17, 0.20, 1
    foreground_color: 0.95, 0.95, 0.95, 1
    cursor_color: 1, 0.72, 0.25, 1
    hint_text_color: 0.55, 0.58, 0.62, 1
    padding: dp(10), dp(8)

<CalcScreen>:
    orientation: 'vertical'
    padding: dp(12), dp(12), dp(12), dp(4)
    spacing: dp(8)
    BoxLayout:
        size_hint_y: None
        height: dp(56)
        spacing: dp(6)
        FieldInput:
            id: h_input
            multiline: False
            input_filter: 'float'
            input_type: 'number'
            font_size: sp(26)
            on_text: root.schedule_calc()
        Button:
            id: sign_button
            text: '±'
            size_hint_x: None
            width: dp(52)
            font_size: sp(20)
            on_release: root.toggle_sign()
    ScrollView:
        id: scroll
        do_scroll_x: False
        bar_width: dp(4)
        Label:
            id: res_output
            size_hint_y: None
            height: self.texture_size[1]
            text_size: self.width, None
            markup: True
            halign: 'center'
            valign: 'top'
            font_size: sp(19)
            on_ref_press: root.copy_value(args[1])

<TableScreen>:
    orientation: 'vertical'
    padding: dp(10), dp(10), dp(10), dp(4)
    spacing: dp(6)
    GridLayout:
        cols: 2
        rows: 3
        size_hint_y: None
        height: dp(114)
        spacing: dp(4)
        Label:
            id: from_label
            font_size: sp(14)
            halign: 'right'
            valign: 'middle'
            text_size: self.size
        FieldInput:
            id: from_input
            multiline: False
            input_filter: 'float'
            input_type: 'number'
            font_size: sp(16)
        Label:
            id: to_label
            font_size: sp(14)
            halign: 'right'
            valign: 'middle'
            text_size: self.size
        FieldInput:
            id: to_input
            multiline: False
            input_filter: 'float'
            input_type: 'number'
            font_size: sp(16)
        Label:
            id: step_label
            font_size: sp(14)
            halign: 'right'
            valign: 'middle'
            text_size: self.size
        FieldInput:
            id: step_input
            multiline: False
            input_filter: 'float'
            input_type: 'number'
            font_size: sp(16)
    BoxLayout:
        size_hint_y: None
        height: dp(44)
        spacing: dp(6)
        Button:
            id: build_button
            font_size: sp(14)
            on_release: root.build_table()
        Button:
            id: export_button
            font_size: sp(14)
            on_release: root.export_csv()
    ScrollView:
        do_scroll_x: True
        do_scroll_y: True
        bar_width: dp(4)
        GridLayout:
            id: grid
            cols: 4
            size_hint: None, None
            width: self.minimum_width
            height: self.minimum_height
            spacing: dp(2), dp(2)

<PlotScreen>:
    orientation: 'vertical'
    padding: dp(10), dp(10), dp(10), dp(4)
    spacing: dp(6)
    BoxLayout:
        size_hint_y: None
        height: dp(40)
        spacing: dp(6)
        Spinner:
            id: parameter_spinner
            font_size: sp(14)
            on_text: root.refresh()
        Spinner:
            id: span_spinner
            font_size: sp(14)
            on_text: root.refresh()
    PlotWidget:
        id: plot

<Root>:
    orientation: 'vertical'
    ScreenManager:
        id: manager
        Screen:
            name: 'calc'
            CalcScreen:
                id: calc_screen
        Screen:
            name: 'table'
            TableScreen:
                id: table_screen
        Screen:
            name: 'plot'
            PlotScreen:
                id: plot_screen
    BoxLayout:
        size_hint_y: None
        height: dp(50)
        spacing: dp(2)
        padding: dp(4), dp(2)
        Button:
            id: nav_calc
            font_size: sp(13)
            on_release: app.show_screen('calc')
        Button:
            id: nav_table
            font_size: sp(13)
            on_release: app.show_screen('table')
        Button:
            id: nav_plot
            font_size: sp(13)
            on_release: app.show_screen('plot')
        Button:
            id: nav_settings
            font_size: sp(13)
            on_release: app.open_settings()
